{
  "name": "dsh-video2text",
  "version": "0.2.2",
  "description": "面板做视频链接转文案；工具给 agent 看视频（video_text / video_frames）。两行可分别禁用。",
  "type": "module",
  "main": "lib/index.mjs",
  "icon": "./icon.svg",
  "files": [
    "lib",
    "docs",
    "skills",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./inspect": {
      "default": "./lib/inspect.mjs"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "video",
    "transcript",
    "asr",
    "douyin",
    "xiaohongshu",
    "bilibili",
    "youtube"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlln/dsh-video2text.git"
  },
  "homepage": "https://github.com/vlln/dsh-video2text",
  "author": "vlln"
}
